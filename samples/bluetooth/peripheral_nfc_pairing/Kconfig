menu "NFC Paring configuration"

choice NFC_TAG_CONNECTION_HANDOVER_ROLE
	prompt "Connection Handover Tag role"
	default NFC_TAG_CH_SELECTOR

config NFC_TAG_CH_SELECTOR
	bool "Connection Handover selector role"
	help
	  NFC Tag is Connection Handover selector device. The Handover Selector
	  is an NFC Forum Device that constructs and replies to a
	  Handover Select Message as a result of a previously received
	  Handover Request Message, or an NFC Tag Device that provides a
	  pre-set Handover Select Message for reading.For more details
	  check NFC Forum Connection Handover 1.5 2.2

config NFC_TAG_CH_REQUESTER
	bool "Connection Handover requester role"
	help
	  NFC Tag is Connection Handover requester device. The Handover Requester
	  is an NFC Forum Device that begins the Handover Protocol by issuing
	  a Handover Request Message to another NFC Forum Device. For more
	  details check NFC Forum Connection Handover 1.5 2.2.

endchoice

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

endmenu

menu "Advertising and user confirm"

config PERIPH_NFC_PAIRING_ADV_ON_BOOT
	bool "Start connectable advertising at boot"
	default y
	help
	  When enabled, the device advertises after Bluetooth initialization.
	  Use this when NFC must not trigger advertising (see
	  PERIPH_NFC_PAIRING_ADV_ON_NFC).

config PERIPH_NFC_PAIRING_ADV_ON_NFC
	bool "Start advertising when the NFC tag is read"
	default n
	help
	  Original sample behavior: connectable advertising starts after an NFC
	  poller reads the NDEF message. Disable to use NFC only for OOB data
	  exchange while advertising is controlled separately.

config PERIPH_NFC_PAIRING_ADV_ON_TNEP_OOB
	bool "Start advertising after TNEP OOB data exchange"
	default n
	depends on !PERIPH_NFC_PAIRING_ADV_ON_NFC
	help
	  If enabled, advertising starts when OOB data is received over TNEP.
	  Leave disabled to avoid advertising changes during NFC handover.

config PERIPH_NFC_PAIRING_DK_BUTTON_CONFIRM
	bool "DK Button 1 confirms pairing / bonding"
	default y
	help
	  Press Button 1 on the DK to accept Numeric Comparison, passkey, or
	  Just Works pairing (same as the ``pairing confirm`` shell command).
	  Button 4 still clears all bonds.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
